#%Module1.0
#####################################################################
##
## nextflow Modulefile
## by Alan Orth <a.orth@cgiar.org>
## May, 2026
##

set appname     nextflow
# real version is 26.04.1
set version     26.04
set prefix      /export/apps/${appname}/${version}
set exec_prefix ${prefix}/bin
set url         "https://github.com/nextflow-io/nextflow"
set msg         "Nextflow is a bioinformatics workflow manager that enables the development of portable and reproducible workflows.\nOfficial site: $url\n"

proc ModulesHelp{ } {
    puts stderr $msg
}

module-whatis $msg


prepend-path    PATH    ${exec_prefix}

# Nextflow v26.04 wants Java v17
# See: https://github.com/nextflow-io/nextflow/blob/v26.04.1/docs/install.md
if { ![is-loaded java/17] } {
    module load java/17
}

# vim: set sw=4 ts=4:
